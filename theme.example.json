{
  "palette": "system",
  "layout": "islands",
  "position": "bottom",
  "margin": 10,
  "scale": 1.0,
  "radius": 20,
  "gap": 8,
  "fill_opacity": 1.0,
  "background": null,
  "border": {
    "color": null,
    "width": 1,
    "off_task_color": null
  },
  "shadow": {
    "enabled": true,
    "opacity": 0.28
  },
  "accent_override": null,
  "font": {
    "family": "Inter Display",
    "size": 14
  },
  "icon_size": 34,
  "sections": [
    "pet",
    "modes",
    "apps",
    "agents",
    "held"
  ],
  "show_unpinned": true,
  "autohide": {
    "enabled": false,
    "reveal_px": 4,
    "hide_delay_ms": 600
  },
  "nudge": {
    "enabled": true
  },
  "agents": {
    "style": "pill",
    "max_rows": 8
  },
  "prompts": {
    "enabled": true,
    "max_visible": 3,
    "width": 360
  },
  "mode_strip": {
    "stay_button": true
  },
  "tooltips": {
    "enabled": true,
    "delay_ms": 350
  },
  "pinned": false,
  "reduced_motion": false,
  "icons": {
    "pack": "icona",
    "stroke": 1.75,
    "mode_fallback": "icona:target",
    "agents": "icona:sparkles",
    "agent_kinds": {
      "claude": "icona:sparkles",
      "codex": "icona:terminal",
      "t3": "icona:zap",
      "opencode": "icona:code",
      "aider": "icona:git-branch",
      "gemini": "icona:star",
      "cursor-agent": "icona:cursor"
    },
    "held": "icona:bell",
    "held_muted": "icona:snooze",
    "timer": "icona:hourglass",
    "stay": "icona:target",
    "nudge": "icona:alert",
    "tag_urgent": "icona:alert",
    "tag_info": "icona:info",
    "tag_ok": "icona:check-circle",
    "card_notification": "icona:bell",
    "card_site": "icona:compass",
    "card_verdict": "icona:check-circle",
    "app_fallback": "icona:layers",
    "pin": "icona:map-pin-fill",
    "pin_off": "icona:map-pin"
  },
  "opacity": 1.0
}
